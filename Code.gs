/** SlipCreator API. Public web app access needed for external UI; protect API with app password. */
const DB='GTMC SlipCreator Cloud Data',REC='LoginRecords',SET='Settings';
function doGet(e){const p=e.parameter||{},a=p.action||'ping',cb=p.callback||'';let x;try{x=api(a,p)}catch(er){x={ok:false,error:er.message||String(er)}}const valid=cb&&/^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$/.test(cb);return ContentService.createTextOutput(valid?cb+'('+JSON.stringify(x)+');':JSON.stringify(x)).setMimeType(valid?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}
function api(a,p){if(a==='ping'){const ss=db_();return {ok:true,service:'SlipCreator API',version:'2.3',database:ss.getName(),spreadsheetUrl:ss.getUrl()};}if(a==='passwordConfigured')return appPasswordConfigured();if(a==='setupPassword')return setupAppPassword(p.password);if(a==='verifyPassword')return verifyAppPassword(p.password);auth_(p.password);if(a==='getRecords')return getRecords();if(a==='getSettings')return getSettings();if(a==='status')return status_();if(a==='saveRecords')return saveRecords(decode_(p.payload));if(a==='saveSettings')return saveSettings(decode_(p.payload));if(a==='changePassword')return changeAppPassword(p.oldPassword,p.newPassword);throw Error('Unknown action '+a)}
function decode_(s){return s?JSON.parse(Utilities.newBlob(Utilities.base64Decode(s)).getDataAsString()):{}}
function auth_(p){if(!verifyAppPassword(p).ok)throw Error('Incorrect app password')}
function db_(){let pr=PropertiesService.getScriptProperties(),id=pr.getProperty('SC_DB');let ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create(DB);if(!id)pr.setProperty('SC_DB',ss.getId());let r=ss.getSheetByName(REC)||ss.insertSheet(REC),s=ss.getSheetByName(SET)||ss.insertSheet(SET);if(!r.getLastRow())r.appendRow(['Username','Password','Class','Student','UpdatedAt']);if(!s.getLastRow())s.appendRow(['Key','Value']);if(!ss.getSheetByName('Instructions')){let i=ss.insertSheet('Instructions');i.getRange(1,1,3,2).setValues([['Warning','Contains login credentials. Keep sheet private.'],['Access','Public web app endpoint required for external UI; app-password protected.'],['Portal','https://greaterportal.vercel.app/']])}return ss}
function getRecords(){let v=db_().getSheetByName(REC).getDataRange().getValues();return {records:v.slice(1).filter(r=>r[0]&&r[1]).map(r=>({username:String(r[0]),password:String(r[1]),klass:String(r[2]||''),student:String(r[3]||'')})),updatedAt:null}}
function saveRecords(a){if(!Array.isArray(a)||a.length>800)throw Error('Invalid records or too many rows (limit 800).');let s=db_().getSheetByName(REC);s.clearContents();s.appendRow(['Username','Password','Class','Student','UpdatedAt']);if(a.length){let n=new Date();s.getRange(2,1,a.length,5).setValues(a.map(r=>[r.username||'',r.password||'',r.klass||'',r.student||'',n]))}return {ok:true,count:a.length,savedAt:new Date().toISOString()}}
function getSettings(){let v=db_().getSheetByName(SET).getDataRange().getValues(),o={portalUrl:'https://greaterportal.vercel.app/',schoolLabel:'Greater Tomorrow Model College',cols:4,rows:5};v.slice(1).forEach(r=>{if(r[0])o[r[0]]=r[1]});return o}
function saveSettings(o){let s=db_().getSheetByName(SET),v=s.getDataRange().getValues(),m={};v.slice(1).forEach((r,i)=>{if(r[0])m[r[0]]=i+2});Object.keys(o||{}).forEach(k=>m[k]?s.getRange(m[k],2).setValue(o[k]):s.appendRow([k,o[k]]));return {ok:true,settings:getSettings()}}
function status_(){let s=db_();return {ok:true,spreadsheetName:s.getName(),spreadsheetUrl:s.getUrl(),records:getRecords().records.length}}
function hash_(p,s){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s+'|'+p))}
function appPasswordConfigured(){return {configured:!!PropertiesService.getScriptProperties().getProperty('SC_HASH')}}
function setupAppPassword(p){let q=PropertiesService.getScriptProperties();if(q.getProperty('SC_HASH'))throw Error('Password already configured');if(!p||p.length<10)throw Error('Use at least 10 characters');let s=Utilities.getUuid();q.setProperties({SC_SALT:s,SC_HASH:hash_(p,s)});return {ok:true}}
function verifyAppPassword(p){let q=PropertiesService.getScriptProperties(),s=q.getProperty('SC_SALT'),h=q.getProperty('SC_HASH');return {ok:!!s&&!!h&&hash_(p||'',s)===h,unconfigured:!h}}
function changeAppPassword(o,n){if(!verifyAppPassword(o).ok)throw Error('Current password incorrect');if(!n||n.length<10)throw Error('New password must be 10+ characters');let q=PropertiesService.getScriptProperties(),s=Utilities.getUuid();q.setProperties({SC_SALT:s,SC_HASH:hash_(n,s)});return {ok:true}}
